# Local dev (default). Used by src/services/api.js via VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:5000

# Optional: tenant subdomain routing (local dev)
# VITE_PLATFORM_DOMAIN=localhost
# VITE_FRONTEND_PORT=5173

# Live / VPS — set on the server or in deployed .env:
# VITE_API_BASE_URL=https://server.elitepic.co.uk
