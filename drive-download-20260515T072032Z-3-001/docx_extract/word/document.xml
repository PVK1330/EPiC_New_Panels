Pr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t>Once the client confirms they wish to proceed, the relevant Data Capture Sheet is sent according to the visa category</w:t></w:r><w:r><w:t xml:space="preserve"> and </w:t></w:r><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Initial mandatory documents are requested, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00FD0651"><w:t>including:</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve"> Passport</w:t></w:r><w:r><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidRPr="00FD0651"><w:t>BRP/</w:t></w:r><w:proofErr w:type="spellStart"/><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00FD0651"><w:t>eVisa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t>,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00FD0651"><w:t>Driving licence (if applicable</w:t></w:r><w:r><w:t>)</w:t></w:r><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="0294C34E" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Once documents and Data Capture Sheet are received, the application form preparation begins. </w:t></w:r></w:p><w:p w14:paraId="2015339F" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Caseworker reviews documents and identifies any missing information or additional documents required. </w:t></w:r></w:p><w:p w14:paraId="686A1BA6" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Further information/documents are requested from the client where necessary. </w:t></w:r></w:p><w:p w14:paraId="49B3ABAF" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Once all information is received, a draft application form is prepared and sent to the client for review and confirmation. </w:t></w:r></w:p><w:p w14:paraId="0CCE467F" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">After client approval of the draft application, the Client Care Letter (CCL) is issued. </w:t></w:r></w:p><w:p w14:paraId="60733B85" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Signed Client Care Letter and required payments are received from the client. </w:t></w:r></w:p><w:p w14:paraId="3FBF3ECC" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Final application is submitted to the Home Office. </w:t></w:r></w:p><w:p w14:paraId="26D8FE04" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Biometrics appointment is booked. </w:t></w:r></w:p><w:p w14:paraId="6D959420" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Biometrics appointment confirmation email/instructions are sent to the client. </w:t></w:r></w:p><w:p w14:paraId="1E608411" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Supporting documents are uploaded prior to the biometrics appointment. </w:t></w:r></w:p><w:p w14:paraId="77B73E23" w14:textId="77777777" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve">Application status is monitored while awaiting Home Office decision. </w:t></w:r></w:p><w:p w14:paraId="30E94ED7" w14:textId="348AE0E0" w:rsidR="00FD0651" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t>Once a decision is received, Approval</w:t></w:r><w:r><w:t>/refusal</w:t></w:r><w:r w:rsidRPr="00FD0651"><w:t xml:space="preserve"> email and decision documents are sent to the client. </w:t></w:r></w:p><w:p w14:paraId="7087DAAB" w14:textId="53AD2CBB" w:rsidR="00097DB7" w:rsidRPr="00FD0651" w:rsidRDefault="00FD0651" w:rsidP="00FD0651"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="auto"/></w:pPr><w:r w:rsidRPr="00FD0651"><w:t>Final case closure email is issued</w:t></w:r><w:r><w:t>.</w:t></w:r></w:p><w:sectPr w:rsidR="00097DB7" w:rsidRPr="00FD0651"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>